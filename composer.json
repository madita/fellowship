{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ably/laravel-broadcaster": "^1.0",
        "astrotomic/laravel-translatable": "^11.16",
        "cviebrock/eloquent-sluggable": "^12.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "http-interop/http-factory-guzzle": "^1.2",
        "laravel/framework": "^12.0",
        "laravel/nightwatch": "^1.7",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.4",
        "laravel/socialite": "^5.24",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^4.0",
        "meilisearch/meilisearch-php": "^1.16",
        "predis/predis": "^3.4",
        "pusher/pusher-php-server": "^7.0",
        "socialiteproviders/discord": "^4.2",
        "spatie/image": "^3.8.3",
        "spatie/laravel-activitylog": "^4.11",
        "spatie/laravel-medialibrary": "^11.13.0",
        "spatie/laravel-permission": "^6.18",
        "stevebauman/purify": "^6.3.1"
    },
    "require-dev": {
        "spatie/laravel-ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "style:check": [
            "styleci analyse --verbose"
        ],
        "style:fix": [
            "styleci fix --verbose"
        ],
        "pre-commit": [
            "@style:check"
        ]
    }
}
