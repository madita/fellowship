{
    "__readme": "Mappings for the stadtwache legacy import. Import on Admin → Migration → Mappings → Import JSON (the source named 'stadtwache' must exist). Order: Legacy Users (all three) → Events → Gallery Collections → Gallery Images → Wiki Terms → Wiki Pages → Forum Threads → Forum Posts, then run the post-import steps on the Runs tab. 'Wiki Pages' needs the MediaWiki ww_text table (not part of the base dump). Forum Posts must run AFTER Forum Threads (posts find their thread via the legacy topic id). Large runs (gallery images, forum posts): use 'php artisan migration:run-mapping \"<name>\"' instead of the dashboard button.",
    "mappings": [
        {
            "source": "stadtwache",
            "name": "Stadtwache: Legacy Users (wiki)",
            "target": "legacy_users",
            "source_table": "ww_user",
            "field_map": {
                "username": {
                    "source": "user_name",
                    "transform": "underscores_to_spaces"
                },
                "legacy_source": {
                    "default": "wiki"
                },
                "email": {
                    "source": "user_email"
                },
                "legacy_user_id": {
                    "source": "user_id"
                },
                "real_name": {
                    "source": "user_real_name"
                },
                "registered_at": {
                    "source": "user_registration",
                    "transform": "datetime",
                    "format": "YmdHis"
                }
            }
        },
        {
            "source": "stadtwache",
            "name": "Stadtwache: Legacy Users (forum)",
            "target": "legacy_users",
            "source_table": "phpbb3_users",
            "field_map": {
                "username": {
                    "source": "username"
                },
                "legacy_source": {
                    "default": "forum"
                },
                "email": {
                    "source": "user_email"
                },
                "legacy_user_id": {
                    "source": "user_id"
                },
                "registered_at": {
                    "source": "user_regdate",
                    "transform": "datetime",
                    "format": "U"
                }
            }
        },
        {
            "source": "stadtwache",
            "name": "Stadtwache: Legacy Users (waechter)",
            "target": "legacy_users",
            "source_table": "waechter",
            "field_map": {
                "username": {
                    "source": "name"
                },
                "legacy_source": {
                    "default": "treffen"
                },
                "email": {
                    "source": "email"
                },
                "legacy_user_id": {
                    "source": "id"
                }
            }
        },
        {
            "source": "stadtwache",
            "name": "Stadtwache: Forum Threads",
            "target": "forum_threads",
            "source_table": "phpbb3_topics",
            "field_map": {
                "title": {
                    "source": "topic_title",
                    "transform": "html_decode"
                },
                "body": {
                    "source": "post_text",
                    "default": "<p><em>Der ursprüngliche erste Beitrag ist im alten Forum verloren gegangen.</em></p>"
                },
                "category": {
                    "source": "forum_name",
                    "transform": "html_decode"
                },
                "legacy_id": {
                    "source": "topic_id"
                },
                "is_locked": {
                    "source": "topic_status",
                    "transform": "bool"
                },
                "is_pinned": {
                    "source": "topic_type",
                    "transform": "int"
                },
                "view_count": {
                    "source": "topic_views",
                    "transform": "int"
                },
                "legacy_owner": {
                    "source": "topic_first_poster_name"
                },
                "legacy_source": {
                    "default": "forum"
                },
                "user_id": {
                    "default": 1
                },
                "created_at": {
                    "source": "topic_time",
                    "transform": "datetime",
                    "format": "U"
                }
            },
            "options": {
                "joins": [
                    {
                        "table": "phpbb3_forums",
                        "type": "inner",
                        "first": "phpbb3_forums.forum_id",
                        "operator": "=",
                        "second": "phpbb3_topics.forum_id"
                    },
                    {
                        "table": "phpbb3_posts",
                        "type": "left",
                        "first": "phpbb3_posts.post_id",
                        "operator": "=",
                        "second": "phpbb3_topics.topic_first_post_id"
                    }
                ],
                "wheres": [
                    {
                        "column": "topic_visibility",
                        "operator": "=",
                        "value": "1"
                    },
                    {
                        "column": "topic_moved_id",
                        "operator": "=",
                        "value": "0"
                    }
                ]
            }
        },
        {
            "source": "stadtwache",
            "name": "Stadtwache: Forum Posts",
            "target": "forum_posts",
            "source_table": "phpbb3_posts",
            "field_map": {
                "thread_legacy_id": {
                    "source": "topic_id"
                },
                "body": {
                    "source": "post_text"
                },
                "legacy_id": {
                    "source": "post_id"
                },
                "legacy_owner": {
                    "source": "username"
                },
                "legacy_source": {
                    "default": "forum"
                },
                "user_id": {
                    "default": 1
                },
                "created_at": {
                    "source": "post_time",
                    "transform": "datetime",
                    "format": "U"
                }
            },
            "options": {
                "joins": [
                    {
                        "table": "phpbb3_topics",
                        "type": "inner",
                        "first": "phpbb3_topics.topic_id",
                        "operator": "=",
                        "second": "phpbb3_posts.topic_id"
                    },
                    {
                        "table": "phpbb3_users",
                        "type": "left",
                        "first": "phpbb3_users.user_id",
                        "operator": "=",
                        "second": "phpbb3_posts.poster_id"
                    }
                ],
                "wheres": [
                    {
                        "column": "post_visibility",
                        "operator": "=",
                        "value": "1"
                    },
                    {
                        "column": "phpbb3_posts.post_id",
                        "operator": "!=",
                        "value": "phpbb3_topics.topic_first_post_id",
                        "compare": "column"
                    }
                ]
            }
        },
        {
            "source": "stadtwache",
            "name": "Stadtwache: Events",
            "target": "events",
            "source_table": "treffen_treffen",
            "field_map": {
                "title": {
                    "source": "location",
                    "transform": "html_decode"
                },
                "description": {
                    "source": "bericht",
                    "transform": "html_decode"
                },
                "startDate": {
                    "source": "starttag",
                    "transform": "date",
                    "format": "Ymd"
                },
                "endDate": {
                    "source": "endtag",
                    "transform": "date",
                    "format": "Ymd"
                },
                "startTime": {
                    "source": "startzeit",
                    "transform": "time",
                    "format": "Hi"
                },
                "endTime": {
                    "source": "endzeit",
                    "transform": "time",
                    "format": "Hi"
                },
                "lat": {
                    "source": "x",
                    "transform": "float"
                },
                "lng": {
                    "source": "y",
                    "transform": "float"
                },
                "album": {
                    "source": "foto_topic"
                },
                "max_participants": {
                    "source": "max_teiln"
                },
                "creator": {
                    "source": "entryuser"
                },
                "legacy_owner": {
                    "source": "entryuser"
                },
                "legacy_source": {
                    "default": "treffen"
                },
                "last_edited_by": {
                    "source": "lasteditby"
                },
                "user_id": {
                    "default": 1
                },
                "event_type_id": {
                    "default": 1
                },
                "created_at": {
                    "source": "entrydate",
                    "transform": "datetime",
                    "format": "!Ymd"
                }
            },
            "options": {
                "locale": "de"
            }
        },
        {
            "source": "stadtwache",
            "name": "Stadtwache: Gallery Collections",
            "target": "gallery_collections",
            "source_table": "treffen_bilder",
            "field_map": {
                "name": {
                    "source": "topic"
                },
                "taxonomy_id": {
                    "default": 1
                },
                "user_id": {
                    "default": 1
                },
                "created_at": {
                    "source": "datum",
                    "transform": "datetime"
                }
            },
            "options": {
                "locale": "de"
            }
        },
        {
            "source": "stadtwache",
            "name": "Stadtwache: Gallery Images",
            "target": "gallery_images",
            "source_table": "treffen_bilder",
            "field_map": {
                "collection": {
                    "source": "topic"
                },
                "base_path": {
                    "default": "C:\\Users\\madit\\PhpstormProjects\\stadtwache\\treffen\\uploads"
                },
                "file": {
                    "template": "{topic|fold}/{id}.jpg"
                },
                "caption": {
                    "source": "info"
                },
                "uploader": {
                    "source": "uploader"
                },
                "legacy_source": {
                    "default": "gallery"
                },
                "created_at": {
                    "source": "datum",
                    "transform": "datetime"
                }
            },
            "options": {
                "locale": "de"
            }
        },
        {
            "source": "stadtwache",
            "name": "Stadtwache: Wiki Terms",
            "target": "wiki_terms",
            "source_table": "ww_category",
            "field_map": {
                "name": {
                    "source": "cat_title",
                    "transform": "underscores_to_spaces"
                }
            },
            "options": {
                "locale": "de"
            }
        },
        {
            "source": "stadtwache",
            "name": "Stadtwache: Wiki Pages (needs ww_text)",
            "target": "wiki_pages",
            "source_table": "ww_page",
            "field_map": {
                "title": {
                    "source": "page_title",
                    "transform": "underscores_to_spaces"
                },
                "content": {
                    "source": "old_text"
                },
                "status": {
                    "source": "page_is_redirect",
                    "transform": "bool"
                },
                "locale": {
                    "default": "de"
                },
                "legacy_owner": {
                    "source": "rev_user_text"
                },
                "legacy_source": {
                    "default": "wiki"
                },
                "user_id": {
                    "default": 1
                },
                "created_at": {
                    "source": "rev_timestamp",
                    "transform": "datetime",
                    "format": "YmdHis"
                }
            },
            "options": {
                "locale": "de",
                "joins": [
                    {
                        "table": "ww_revision",
                        "type": "inner",
                        "first": "ww_revision.rev_id",
                        "operator": "=",
                        "second": "ww_page.page_latest"
                    },
                    {
                        "table": "ww_text",
                        "type": "inner",
                        "first": "ww_text.old_id",
                        "operator": "=",
                        "second": "ww_revision.rev_text_id"
                    }
                ],
                "wheres": [
                    {
                        "column": "page_namespace",
                        "operator": "=",
                        "value": "0"
                    }
                ]
            }
        }
    ]
}
